{
  "name": "hello",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["scope:app", "app:hello"],
  "implicitDependencies": ["hello-api", "@hub/hello-web"],
  "targets": {
    "validate": {
      "description": "Build, start, health-check and tear down a throwaway instance (hub validate).",
      "command": "go run ./platform/core/cmd/hub validate hello",
      "cache": false
    },
    "docker-build": {
      "description": "Build the app image the way the core does.",
      "command": "docker compose -p hub-hello -f apps/hello/compose.yaml build",
      "cache": false
    }
  }
}
