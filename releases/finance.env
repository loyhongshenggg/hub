# A Windows release: one WSL distribution (<NAME>.wsl) with the hub and these
# apps. Build: tools/release/build.sh finance <version>. Publish: push the tag
# finance-v<version> (see .github/workflows/release.yml and docs/adr/0011-releases.md).
NAME=finance         # distribution name, file names, Desktop icon
TITLE=Finance        # shown to people
APPS="finance"       # apps/<id> to ship (personal apps never ship unless listed)
PORT=7100            # local port; not 7000, so it can sit next to a dev hub
