# yaml-language-server: $schema=../../libs/manifest/schema/v1.schema.json
manifestVersion: 1
id: <%= id %>
name: <%- JSON.stringify(name) %>
description: <%- JSON.stringify(description) %>
icon: ./icon.svg
runtime:
  driver: docker
  compose: ./compose.yaml
  service: <%= template === 'image' ? 'app' : 'web' %>
  port: <%= port %>
health:
  path: <%= healthPath %>
  startTimeout: <%= template === 'image' ? '120s' : '30s' %>
ui:
  path: /
  keepAlive: true
autoStart: false
<% if (template === 'go-react') { %>
# Dev mode (power menu → "Dev mode"): the core runs these on the host with
# live reload instead of the container, and routes the app's URL to `web`.
dev:
  route: web
  processes:
    - name: api
      dir: api
      command: go run .
      watch: ['*.go', go.mod] # restart the API when Go files change
    - name: web
      dir: web
      command: pnpm exec vite # hot reload; proxies /api and /healthz to the API
<% } %>
