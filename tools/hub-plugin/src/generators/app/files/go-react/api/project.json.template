{
  "name": "<%= id %>-api",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["scope:app", "app:<%= id %>", "lang:go"],
  "implicitDependencies": ["<%= webPackage %>"],
  "targets": {
    "embed-ui": {
      "description": "Copy the web build into ui/dist for go:embed.",
      "command": "rm -rf ui/dist && cp -r ../web/dist ui/dist",
      "options": { "cwd": "{projectRoot}" },
      "dependsOn": ["<%= webPackage %>:build"],
      "inputs": [{ "dependentTasksOutputFiles": "**/*" }],
      "outputs": ["{projectRoot}/ui/dist"],
      "cache": true
    },
    "build": {
      "dependsOn": ["generate", "embed-ui"],
      "options": { "main": "main.go", "outputPath": "dist/apps/<%= id %>/api/app" },
      "inputs": ["goSource", "^goSource", "{projectRoot}/ui/**/*"]
    },
    "serve": {
      "options": { "env": { "PORT": "<%= port %>", "DATA_DIR": "./tmp-data" } }
    }
  }
}
