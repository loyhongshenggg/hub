{
  "name": "<%= id %>",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["scope:app", "app:<%= id %>"],
  "implicitDependencies": ["<%= id %>-api", "<%= webPackage %>"],
  "targets": {
    "validate": {
      "description": "Build, start, health-check and tear down a throwaway instance (hub validate).",
      "command": "go run ./platform/core/cmd/hub validate <%= id %>",
      "cache": false
    },
    "docker-build": {
      "description": "Build the app image the way the core does.",
      "command": "docker compose -p hub-<%= id %> -f apps/<%= id %>/compose.yaml build",
      "cache": false
    }
  }
}
